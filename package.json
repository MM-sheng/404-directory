{
  "name": "404-directory",
  "version": "0.4.4",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.service.json",
    "start": "node dist/server.js",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:start": "node dist/mcp/server.js",
    "mcp:smoke": "tsx scripts/smoke-mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.service.json --noEmit",
    "docker:build": "docker build -t 404-directory:latest .",
    "docker:up": "docker compose up --build -d",
    "web:dev": "next dev",
    "web:build": "next build",
    "web:start": "next start"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
