# 404.directory multi-tool platform
HOST=127.0.0.1
PORT=4040
PUBLIC_BASE_URL=https://404.directory

# Browser collection limits (understand_webpage)
PAGE_TIMEOUT_MS=20000
NETWORK_IDLE_MS=3000
STABILITY_POLL_MS=400
MAX_WAIT_MS=5000
MAX_TEXT_CHARS=20000
MAX_ELEMENTS=200
BROWSER_EGRESS_ALLOWED_PORTS=80,443
BROWSER_MAX_RESOURCE_BYTES=5242880
HEADLESS=true

# verify_web limits
VERIFY_TIMEOUT_MS=10000
VERIFY_MAX_BODY_BYTES=512000
VERIFY_MAX_REDIRECTS=5

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
TOOL_RATE_LIMIT_MAX=20

# Agent Tool Registry / Discovery (Phase 1)
# Leave unset for memory fallback (local). Set for Postgres in production.
DATABASE_URL=
# Production MUST set CATALOG_MEMORY_FALLBACK=false with a managed Postgres.
CATALOG_MEMORY_FALLBACK=true
# Registry writes require Bearer admin token or provider API key (default true).
REGISTRY_REQUIRE_AUTH=true
REGISTRY_ADMIN_TOKEN=
OWNERSHIP_CHALLENGE_COOLDOWN_MS=3600000
VERIFICATION_WORKER_ENABLED=true
# Prefer external worker on Cloud Run (request-based billing kills idle setInterval).
VERIFICATION_WORKER_MODE=inline
VERIFICATION_INTERVAL_MS=300000
VERIFICATION_BATCH_SIZE=20
SEED_FIRST_PARTY_TOOLS=true

# Optional LLM refinement for understand_webpage (compressed signals only)
ENABLE_LLM=false
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_ID=gpt-4o-mini
LLM_TIMEOUT_MS=12000
